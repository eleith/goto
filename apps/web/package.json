{
	"name": "@goto/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"files": [
		"build",
		"server.js"
	],
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --strictPort",
		"build": "vite build",
		"start": "node server.js",
		"preview": "node server.js",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --ignore-path ../../.prettierignore --check . && eslint .",
		"format": "prettier --ignore-path ../../.prettierignore --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "pnpm --filter @goto/worker... build && playwright test"
	},
	"dependencies": {
		"@goto/analytics": "workspace:*",
		"@goto/config": "workspace:*",
		"@goto/db": "workspace:*",
		"better-auth": "catalog:",
		"piscina": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-node": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
