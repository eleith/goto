{
	"name": "@goto/worker",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "node --conditions=development --watch --import ../../tools/register.mjs src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"check": "tsc --noEmit -p tsconfig.json",
		"lint": "prettier --ignore-path ../../.prettierignore --check . && eslint .",
		"format": "prettier --ignore-path ../../.prettierignore --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:smoke": "node e2e/startup.mjs"
	},
	"dependencies": {
		"@goto/config": "workspace:*",
		"openworkflow": "catalog:",
		"tslog": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
